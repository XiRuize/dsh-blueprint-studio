{
  "name": "dsh-blueprint-studio",
  "version": "0.2.1",
  "private": false,
  "description": "Plan requirements and software-engineering diagrams with the agent before coding, review versioned blueprints, then confirm and dispatch module subagents.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Blueprint Studio contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiRuize/dsh-blueprint-studio.git"
  },
  "homepage": "https://github.com/XiRuize/dsh-blueprint-studio#readme",
  "bugs": {
    "url": "https://github.com/XiRuize/dsh-blueprint-studio/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "software-engineering",
    "uml",
    "use-case",
    "data-flow-diagram",
    "sequence-diagram",
    "er-diagram",
    "c4-model",
    "blueprint"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/*.png",
    "docs/*.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/blueprint.js",
    "test": "node --test test/blueprint.test.mjs"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
